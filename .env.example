# -- Servidor ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# -- Auth ---------------------------------------------------------------------
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
CSRF_SECRET=cambia-esto-por-otro-secreto-de-al-menos-32-caracteres

# -- Base de datos -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/sofiapp

# -- Redis (BullMQ) ------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# -- LLM / Gemini --------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=15000
AI_CACHE_TTL_CHAT_S=3600
AI_CACHE_TTL_CLASSIFY_S=7200
