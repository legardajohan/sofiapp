# -- Servidor ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# -- Auth ---------------------------------------------------------------------
JWT_SECRET=cambia-esto-por-un-secreto-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
CSRF_SECRET=cambia-esto-por-otro-secreto-de-al-menos-32-caracteres

# -- Base de datos -------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/sofiapp

# -- Redis (BullMQ) ------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# -- LLM / Gemini --------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=15000
AI_CACHE_TTL_CHAT_S=3600
AI_CACHE_TTL_CLASSIFY_S=7200

# ─── Media de la conversación (HU-OMNI-06, ADR-0008) ───────────────────────────
# `local` no necesita infraestructura: escribe en MEDIA_LOCAL_DIR. `spaces` exige las cinco
# SPACES_* (env.ts aborta el arranque si falta alguna).
MEDIA_DRIVER=local
MEDIA_LOCAL_DIR=./var/media
# HMAC de las URLs firmadas de media. 64 hex. OBLIGATORIA fuera de NODE_ENV=test.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MEDIA_URL_SECRET=
MEDIA_URL_TTL_S=3600
MEDIA_SIGNED_URL_TTL_S=300
# Kill-switch de la descarga de media entrante. Enum, NO booleano.
MEDIA_INGEST_ENABLED=on
MEDIA_MAX_BYTES_IMAGEN=5242880
MEDIA_MAX_BYTES_VIDEO=16777216
MEDIA_MAX_BYTES_AUDIO=16777216
# 16 MB y no los 100 MB de Meta: el multipart entra en memoria (multer.memoryStorage()).
MEDIA_MAX_BYTES_DOCUMENTO=16777216
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_BUCKET=
SPACES_KEY=
SPACES_SECRET=
