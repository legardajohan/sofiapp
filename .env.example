# ─── SofiApp — .env.example ───────────────────────────────────────────────
# Copia a .env (backend) y rellena. El backend valida TODAS estas vars con Zod
# al arranque y FALLA si falta alguna crítica (sin fallbacks inseguros).

# App
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173        # origen del frontend (Vercel en prod)
LOG_LEVEL=info                          # error | warn | info | debug

# Auth
JWT_SECRET=                             # OBLIGATORIO. Sin fallback. Genera uno fuerte.
JWT_EXPIRES_IN=8h
# Cookie de sesión (SPA) — ver docs/adr/0002-auth-token-transport.md
COOKIE_DOMAIN=                          # ej. .sofiapp.com en prod; vacío en local
COOKIE_SAMESITE=lax                     # lax | strict | none (none requiere Secure + cross-site)
CSRF_SECRET=                            # OBLIGATORIO. Firma el token CSRF double-submit.

# Base de datos
MONGODB_URI=                            # MongoDB Atlas

# Redis (broker de colas BullMQ; sin caché semántica en el MVP)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Meta (WhatsApp / IG / Messenger — BSP)
META_APP_ID=
META_APP_SECRET=                        # validación HMAC del webhook
META_VERIFY_TOKEN=                      # verificación GET del webhook
META_GRAPH_VERSION=v19.0
TENANT_TOKEN_ENC_KEY=                   # clave AES-256-GCM para cifrar tokens de tenant

# LLM (Gemini 1.5 Flash)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
LLM_TIMEOUT_MS=15000

# Storage (DigitalOcean Spaces — S3 compatible)
SPACES_ENDPOINT=
SPACES_REGION=
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
