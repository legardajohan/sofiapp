{
  "name": "@sofiapp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "tsx watch --env-file .env src/app.ts",
    "dev:worker": "tsx watch --env-file .env src/worker.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@sofiapp/shared": "workspace:*",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.0.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "socket.io": "^4.8.3",
    "zod": "^3.24.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "version": "7.0.24",
      "downloadDir": "../../.mongodb-binaries"
    }
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "dotenv": "^16.4.5",
    "mongodb-memory-server": "^10.1.4",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
