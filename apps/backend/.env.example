# Entorno
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Auth — mínimo 32 caracteres, sin fallback (el proceso aborta si faltan)
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h
CSRF_SECRET=cambia_esto_por_otro_secreto_de_al_menos_32_caracteres

# Base de datos
MONGODB_URI=mongodb://localhost:27017/sofiapp

# Redis (BullMQ broker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# LLM / Gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=15000
AI_CACHE_TTL_CHAT_S=3600
AI_CACHE_TTL_CLASSIFY_S=7200

# Ventana de agrupacion del auto-reply (HU-IA-02)
AI_REPLY_WINDOW_MS=8000

# Semaforizacion automatica por intencion de compra (HU-IA-05)
# Enum 'on'|'off', NO booleano: "false" coaccionado a booleano daria true.
SEMAFORO_AUTO=on
# Confianza minima (0-1) para que la IA ESCRIBA el semaforo; por debajo solo propone.
SEMAFORO_MIN_CONFIANZA=0.7
# Turnos del cliente antes de tocar el semaforo.
SEMAFORO_MIN_TURNOS_CLIENTE=2

# Extraccion automatica de datos de contacto (HU-IA-06)
# Enum 'on'|'off', por el mismo motivo que SEMAFORO_AUTO.
EXTRACT_AUTO=on
# Turnos del cliente antes de extraer sola.
EXTRACT_MIN_TURNOS_CLIENTE=2
# Techo del transcript que se le manda al modelo al extraer.
EXTRACT_MAX_MENSAJES=60
