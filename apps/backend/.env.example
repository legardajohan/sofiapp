# Entorno
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:5173

# Auth — mínimo 32 caracteres, sin fallback (el proceso aborta si faltan)
JWT_SECRET=cambia_esto_por_un_secreto_de_al_menos_32_caracteres
JWT_EXPIRES_IN=8h
CSRF_SECRET=cambia_esto_por_otro_secreto_de_al_menos_32_caracteres

# Base de datos
MONGODB_URI=mongodb://localhost:27017/sofiapp

# Redis (BullMQ broker)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# LLM / Gemini
LLM_PROVIDER=gemini
GEMINI_API_KEY=tu_api_key_de_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_MS=15000
AI_CACHE_TTL_CHAT_S=3600
AI_CACHE_TTL_CLASSIFY_S=7200

# Ventana de agrupacion del auto-reply (HU-IA-02)
AI_REPLY_WINDOW_MS=8000

# Semaforizacion automatica por intencion de compra (HU-IA-05)
# Enum 'on'|'off', NO booleano: "false" coaccionado a booleano daria true.
SEMAFORO_AUTO=on
# Confianza minima (0-1) para que la IA ESCRIBA el semaforo; por debajo solo propone.
SEMAFORO_MIN_CONFIANZA=0.7
# Turnos del cliente antes de tocar el semaforo.
SEMAFORO_MIN_TURNOS_CLIENTE=2

# Extraccion automatica de datos de contacto (HU-IA-06)
# Enum 'on'|'off', por el mismo motivo que SEMAFORO_AUTO.
EXTRACT_AUTO=on
# Turnos del cliente antes de extraer sola.
EXTRACT_MIN_TURNOS_CLIENTE=2
# Techo del transcript que se le manda al modelo al extraer.
EXTRACT_MAX_MENSAJES=60

# Tema por conversación para «Productos más consultados» (HU-REP-03).
# Interruptor como enum y NO como booleano, por el mismo motivo que SEMAFORO_AUTO: "false"
# coaccionado a booleano daría true y el kill-switch dejaría de existir justo cuando hace falta.
# Apagarlo también frena el backfill: comparten el guard.
TEMA_AUTO=on
# Mensajes del CLIENTE antes de clasificar. Con 1, un "hola" suelto acabaría siempre en `otros`.
TEMA_MIN_TURNOS_CLIENTE=2
# Confianza mínima (0-1) para guardar el tema; por debajo se guarda como `otros`: un producto
# adivinado ensucia más el ranking que una conversación sin producto. Escala propia del modelo,
# igual que SEMAFORO_MIN_CONFIANZA.
TEMA_MIN_CONFIANZA=0.6
# Freno de coste: mensajes nuevos del cliente desde la última clasificación antes de repetirla.
TEMA_RECLASIFICAR_CADA=3
# Y cuántos cuando el tema ya salió igual dos veces seguidas (repeticiones >= 2, tema estable).
TEMA_RECLASIFICAR_ESTABLE=15

# HU-REP-06 — tiempo activo del asesor (opcionales; estos son los valores por defecto).
# Cada cuánto envía un latido una pestaña activa del asesor, en ms.
# Debe coincidir con la constante del frontend (features/activity): si el navegador late
# más despacio que esto, cada latido parece el primero tras un hueco y el tiempo sale recortado.
ACTIVITY_HEARTBEAT_MS=60000 # 60000 ---->1 minuto por defecto
# Retraso que se le perdona a un latido antes de contar el hueco como inactividad, en ms.
ACTIVITY_TOLERANCIA_MS=30000 # 30000 ---->30 segundos por defecto
